{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dayforge",
  "version": "0.1.0",
  "identifier": "com.zoey.dayforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dayforge",
        "width": 336,
        "height": 336,
        "minWidth": 336,
        "minHeight": 336,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Zoey-0314",
    "shortDescription": "Local-first productivity and growth desktop widget",
    "longDescription": "Dayforge is a persistent Windows desktop productivity widget with EXP, activity heatmaps, tasks, habits, focus timers, and sleep records.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
